{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "Auth": {
    "SessionCookieName": "__Host-ul_session",
    "CsrfCookieName": "__Host-ul_csrf",
    "SameSite": "Lax",
    "SessionMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Bootstrap": {
    "Token": ""
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": ""
  }
}
