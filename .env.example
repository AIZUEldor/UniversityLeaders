# Copy to .env and replace placeholders. Never commit .env.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=university_leaders
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# MinIO (local object storage for report attachments; see infra/docker-compose.yml)
MINIO_ROOT_USER=change_me_admin
MINIO_ROOT_PASSWORD=change_me_at_least_8_chars
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_BUCKET=report-attachments
# Least-privilege account for the API (created by minio-init; access to MINIO_BUCKET only)
MINIO_APP_ACCESS_KEY=ul-api
MINIO_APP_SECRET_KEY=change_me_at_least_8_chars

# Backend
ASPNETCORE_ENVIRONMENT=Development
Database__ConnectionString=Host=localhost;Port=5433;Database=university_leaders;Username=change_me;Password=change_me
# One-time University Leader bootstrap. Empty = endpoint disabled. Use >= 32 random chars only while bootstrapping, then clear it.
Bootstrap__Token=
# Exact origin of the deployed frontend (CORS with credentials). Empty = no cross-origin access.
# Cors__AllowedOrigins__0=https://your-frontend.example    (local dev: http://localhost:3000)
# Lax when frontend and API share a site; None when they are on different sites (e.g. two *.onrender.com hosts).
# Local dev with the Next.js dev server on http://localhost:3000 needs None plus the CORS origin below (see frontend/README.md).
Auth__SameSite=Lax
# true only behind a TLS-terminating reverse proxy that is the sole entry point (e.g. Render).
ForwardedHeaders__Enabled=false
# Object storage used by the API (must match the MinIO app account above)
ObjectStorage__ServiceUrl=http://localhost:9010
ObjectStorage__Bucket=report-attachments
ObjectStorage__AccessKey=ul-api
ObjectStorage__SecretKey=change_me_at_least_8_chars
# SigV4 signing region: us-east-1 for MinIO and Cloudflare R2, the bucket region for AWS S3. Production requires an https ServiceUrl.
ObjectStorage__Region=us-east-1

# Data Protection key encryption (required in Production, optional elsewhere). Path to a mounted secret file
# (.pfx/.p12 or .pem with the private key); the password only if the file is protected. Never commit either.
# DataProtection__Certificate__Path=/etc/secrets/dataprotection.pfx
# DataProtection__Certificate__Password=
# Rotation: retired certificate kept only to decrypt older keys.
# DataProtection__PreviousCertificates__0__Path=/etc/secrets/dataprotection-previous.pfx
# DataProtection__PreviousCertificates__0__Password=

# Frontend (the Next.js app reads it from frontend/.env.local; see frontend/.env.example)
NEXT_PUBLIC_API_URL=https://localhost:5001
